---
// The site title is the homepage's h1; elsewhere it's decorative.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = pathname === "/";
const pages = [
  { href: "/", label: "Home" },
  { href: "/wall", label: "Wall" },
  { href: "/books", label: "Books" },
  { href: "/quotes", label: "Quotes" },
  { href: "/til", label: "TIL" },
  { href: "/projects", label: "Projects" },
  { href: "/posts", label: "Posts" },
  { href: "/fitness", label: "Fitness" },
];
---

<nav aria-label="Main">
  {
    isHome ? (
      <h1 class="site-title">Lucien O</h1>
    ) : (
      <span class="site-title">Lucien O</span>
    )
  }
  <div>
    {pages.map(({ href, label }) => (
      <a
        href={href === "/" ? href : `${href}/`}
        aria-current={pathname === href ? "page" : href !== "/" && pathname.startsWith(`${href}/`) ? "location" : undefined}
        data-astro-prefetch={href === "/wall" ? "tap" : "hover"}
      >
        {label}
      </a>
    ))}
  </div>
</nav>
<style>
  .site-title {
    font-weight: bold;
    font-size: 1.1em;
    display: inline-block;
    margin: 0;
    padding-block: 0.5rem;
  }

  nav div {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.65rem;
    row-gap: 0.25rem;
  }

  nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: none;
  }

  nav a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0.15rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  nav a:is(:hover, :focus-visible, [aria-current])::after {
    transform: scaleX(1);
  }

  nav a[aria-current] {
    color: inherit;
  }

  nav a[aria-current]::after {
    height: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    nav a::after {
      transition: transform 160ms ease-out;
    }
  }
</style>
