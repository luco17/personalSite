---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { byDateDesc } from "@/lib/sort";

const allBooks = await getCollection("books");
---

<Layout
  title="LOD - Books"
  description="A list of books I've read since 2021, with links to the ones I've written notes on."
>
  <main id="main-content" tabindex="-1">
    <header class="page-heading">
      <h1>Books</h1>
    </header>
    <hr />
    <ul class="entry-list">
      {
        allBooks
        .sort(byDateDesc)
        .map((book) => (
          <li>
            {book.data.link ? (
              <a href={`/books/${book.id}/`} data-astro-prefetch>{book.data.title}</a><span class="entry-meta"> - {book.data.author}</span>
            ) : (
              <span>{book.data.title} - </span><span class="entry-meta">{book.data.author}</span>
            )}
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
