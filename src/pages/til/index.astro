---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { byDateDesc } from "@/lib/sort";

const allTil = await getCollection("til");
---

<Layout title="LOD - TIL" description="Things I learned today.">
  <main id="main-content" tabindex="-1">
    <header class="page-heading">
      <h1>TIL</h1>
    </header>
    <hr />
    <ul class="entry-list">
      {
        allTil
        .sort(byDateDesc)
        .map((til) => (
          <li>
            <a href={`/til/${til.id}/`} data-astro-prefetch>{til.data.title}</a>
            <span class="entry-meta date"><time datetime={til.data.date.toISOString().slice(0, 10)}>{til.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</time></span>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  .date {
    display: inline-block;
    margin-inline-start: 0.6em;
  }
</style>
