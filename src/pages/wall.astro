---
import Layout from "@/layouts/Layout.astro";
import { env } from "cloudflare:workers";
import {
  parseWallCursor,
  wallCursorUrl,
  wallPageSize,
  wallPostsQuery,
  type WallNote,
} from "@/lib/wall";

const parseCreatedAt = (value: string) => {
  const isoValue = value.includes("T") ? value : `${value.replace(" ", "T")}Z`;
  const date = new Date(isoValue);
  return Number.isNaN(date.getTime()) ? null : date;
};

const formatDate = (value: string) => {
  const date = parseCreatedAt(value);
  if (!date) return value;

  const formattedDate = date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: "Europe/London",
  });
  const formattedTime = date.toLocaleTimeString("en-GB", {
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Europe/London",
  });
  return `${formattedDate}, ${formattedTime}`;
};

const dateTimeAttribute = (value: string) => parseCreatedAt(value)?.toISOString();

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");

const trailingUrlPunctuation = /[),.;:!?]+$/;
const urlPattern = /https?:\/\/[^\s<>"']+/g;

const linkify = (value: string) =>
  escapeHtml(value).replace(urlPattern, (url) => {
    const punctuation = url.match(trailingUrlPunctuation)?.[0] ?? "";
    const href = url.slice(0, url.length - punctuation.length);
    return `<a href="${href}">${href}</a>${punctuation}`;
  });

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=30, stale-while-revalidate=300",
);

const before = parseWallCursor(Astro.url.searchParams);
if (Astro.url.searchParams.has("before") && !before) {
  return Astro.redirect("/wall/", 302);
}
let notes: WallNote[] = [];
let errorMsg = "";

try {
  const { results } = await env.pensieve_db
    .prepare(wallPostsQuery)
    .bind(
      before?.created_at ?? null,
      before?.created_at ?? null,
      before?.created_at ?? null,
      before?.id ?? null,
      wallPageSize + 1,
    )
    .all<WallNote>();

  notes = results;
} catch (error: unknown) {
  console.error("Wall entries could not be loaded", error);
  errorMsg = "Notes are temporarily unavailable; please try again shortly.";
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("Retry-After", "60");
}

const hasMore = notes.length > wallPageSize;
const entries = notes.slice(0, wallPageSize);
const oldestEntry = entries.at(-1);
const olderUrl = !errorMsg && hasMore && oldestEntry ? wallCursorUrl(oldestEntry) : null;
const moreRecentUrl = before ? "/wall/" : null;
---

<Layout
  title="LOD - Wall"
  description="Notes, clips and links worth keeping."
  canonicalPath={before ? wallCursorUrl(before) : "/wall/"}
>
  <main class="wall" id="main-content" tabindex="-1">
    <h1>Wall</h1>
    <p class="wall-intro">Notes, clips and links worth keeping.</p>
    <hr />

    {errorMsg && (
      <div class="error-banner" role="status">
        <p>{errorMsg}</p>
      </div>
    )}

    {!errorMsg && entries.length === 0 && (
      <p class="empty-state">Nothing here yet.</p>
    )}

    {entries.length > 0 && (
      <div class="stack">
        {entries.map((entry) => (
          <article class="post-item" id={`note-${entry.id}`}>
            <div class="post-header">
              <time class="post-date" datetime={dateTimeAttribute(entry.created_at)}>
                {formatDate(entry.created_at)}
              </time>
            </div>
            <div class="post-body" set:html={linkify(entry.content)} />
          </article>
        ))}
      </div>
    )}

    <footer class="footer-controls">
      {moreRecentUrl && (
        <a class="wall-page-link group" href={moreRecentUrl}>
          <span class="animate-arrow-spring" aria-hidden="true">&larr;</span>
          More recent
        </a>
      )}
      {olderUrl && (
        <a class="wall-page-link older-link group" href={olderUrl}>
          Older
          <span class="animate-arrow-spring arrow-right" aria-hidden="true">&rarr;</span>
        </a>
      )}
    </footer>
  </main>
</Layout>

<style>
  .wall {
    font-size: 1rem;
    margin-block: 1rem;
  }

  h1 {
    font-weight: 600;
  }

  .wall-intro {
    line-height: 1.5;
  }

  .stack {
    margin-top: 1.5rem;
  }

  .post-item {
    margin-block: 0;
    padding-block: 1.25rem;
    border-bottom: 1px solid #ececec;
  }

  .post-item:first-of-type {
    padding-top: 0;
  }

  .post-item:last-of-type {
    border-bottom: none;
  }

  .post-header {
    color: #666;
    font-family:
      ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .post-body {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.45;
  }

  .error-banner {
    background: #fff0f0;
    border-left: 4px solid #ff3b30;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    border-radius: 4px;
    color: #8b0000;
    font-size: 0.95rem;
  }

  .error-banner p {
    margin: 0.25rem 0 0 0;
  }

  .empty-state {
    font-style: italic;
    color: #666;
    text-align: center;
    margin: 2rem 0;
  }

  .footer-controls {
    margin-top: 2rem;
    padding-top: 0.85rem;
    border-top: 1px solid #ececec;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.78rem;
    color: #666;
  }

  .footer-controls a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    border-radius: 999px;
    color: #666;
    line-height: 1;
    padding: 0.35rem 0.55rem;
    text-decoration: none;
  }

  .footer-controls a:visited {
    color: #666;
  }

  .footer-controls a:hover,
  .footer-controls a:focus-visible {
    background: #f6f6f6;
    color: #111;
  }

  .older-link {
    margin-left: auto;
  }

  @media (prefers-color-scheme: dark) {
    .post-item,
    .footer-controls {
      border-color: #222;
    }

    .post-header,
    .empty-state,
    .footer-controls,
    .footer-controls a,
    .footer-controls a:visited {
      color: #888;
    }

    .footer-controls a:hover,
    .footer-controls a:focus-visible {
      background: #1b1b1b;
      color: #fff;
    }

    .error-banner {
      background: #2a1111;
      color: #ffb3b3;
      border-left-color: #ff453a;
    }
  }
</style>
