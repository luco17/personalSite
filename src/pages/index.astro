---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import lucienSqrSml from "@/assets/lucienSqrSml.webp";
---

<Layout title="LOD - Home">
  <main id="main-content" tabindex="-1">
    <article>
      <Image
        src={lucienSqrSml}
        width={130}
        densities={[1, 2, 3]}
        priority
        alt="Lucien O"
      />
      <p>
        I work at the intersection of code, AI, defence, accounting, data. Always learning, always trying to ship faster. I'm currently helping build <a href="https://cloudsecure.ltd">Cloudsecure</a>.
      </p>
      <p>I live in England and am curious about:</p>
      <ul>
        <li>Building companies</li>
        <li>What makes people buy things</li>
        <li>Great salespeople/dealmakers</li>
        <li>Resisting feature creep</li>
        <li>Clear writing</li>
        <li>Shipping software fast</li>
        <li>UX/UI design</li>
        <li>Why government IT projects are often so slow</li>
        <li>AI ops automation</li>
      </ul>
    </article>
  </main>
</Layout>

<style>
  article {
    margin: 0;
  }

  img {
    display: block;
    border-radius: 5%;
    margin-bottom: 1.75rem;
  }

  p {
    margin-block: 0 1.5rem;
    max-width: 65ch;
  }

  p + p {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  ul {
    margin-block: 0;
    padding-left: 1.2rem;
  }

  li + li {
    margin-top: 0.35rem;
  }
</style>
