{
  "name": "PersonalSite",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run generate-types && astro check && astro build && node scripts/write-build-info.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test scripts/*.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "d1:pull:local": "node ./scripts/pull-local-d1-from-remote.mjs --config ./wrangler.jsonc --persist-to ./.wrangler/state --database pensieve-db"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.123.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
